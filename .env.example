# Copie para .env.local e preencha (o .env.local não vai para o git).
# Supabase → Project Settings → API / Data API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# NUNCA coloque aqui a "secret key" (sb_secret_...) nem a senha do banco:
# tudo que começa com VITE_ vai para o navegador dos hóspedes.

# O hotel vem do endereço (hotelguia.com.br/<id>). Opcional: hotel aberto na raiz "/" — útil só no
# desenvolvimento local. Em produção deixe VAZIO para a raiz mostrar a página da plataforma.
VITE_HOTEL_ID=

# Opcional — CAPTCHA no login (Cloudflare Turnstile). Configure ANTES de ativar o CAPTCHA no Supabase.
VITE_TURNSTILE_SITE_KEY=
